PORT=3001
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co

# Server-side only. Has full database access and bypasses Row Level Security (RLS).
# Never expose this to the dashboard/frontend, and never commit a real value here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ALLOWED_ORIGINS=http://localhost:5173
